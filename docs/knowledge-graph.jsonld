        "UPRN"
      ],
      "dct:references": [
        {
          "@id": "ndl:standard/uprn-usrn"
        }
      ],
      "dct:source": [
        "https://www.gov.uk/guidance/stamp-duty-land-tax-online-and-paper-returns",
        "https://www.gov.uk/hmrc-internal-manuals/stamp-duty-land-tax-manual/sdltm50200"
      ],
      "ndl:provenance": "S",
      "dct:date": "2026-11-20"
    },
    {
      "@id": "ndl:exchange/set-up-a-company",
      "@type": "schema:Action",
      "schema:name": "Set up a company and register for Corporation Tax together",
      "schema:description": "Company registration details, passed on so the company is set up for Corporation Tax",
      "ndl:journey": "Set up a limited company",
      "schema:audience": "Business",
      "schema:participant": [
        "Companies House",
        "HMRC"
      ],
      "ndl:mechanism": "Joint service: registering with Companies House usually sets the company up for Corporation Tax too",
      "ndl:sharedIdentifier": [
        "Company registration number",
        "Unique Taxpayer Reference"
      ],
      "dct:references": [
        {
          "@id": "ndl:standard/bods"
        }
      ],
      "dct:source": [
        "https://www.gov.uk/limited-company-formation/register-your-company",
        "https://www.gov.uk/government/news/helping-hand-to-set-up-new-businesses"
      ],
      "ndl:provenance": "S",
      "dct:date": "2026-11-20"
    },
    {
      "@id": "ndl:exchange/ukef-hmrc",
      "@type": "schema:Action",
      "schema:name": "Export finance and trade: UK Export Finance and HMRC",
      "schema:description": "VAT and EORI checks on exporters, published trade statistics and commodity codes",
      "ndl:journey": "Export goods with export finance",
      "schema:audience": "Business",
      "schema:participant": [
        "UK Export Finance",
        "HMRC",
        "Department for Business and Trade"
      ],
      "ndl:mechanism": "Published HMRC APIs; restricted customs data needs a legal route",
      "ndl:sharedIdentifier": [
        "VAT registration number",
        "EORI number",
        "Commodity code"
      ],
      "dct:references": [
        {
          "@id": "ndl:standard/api-standards"
        },
        {
          "@id": "ndl:standard/openapi-3"
        }
      ],
      "dct:source": [
        "https://developer.service.hmrc.gov.uk/api-documentation",
        "https://www.uktradeinfo.com/api-documentation"
      ],
      "ndl:provenance": "V",
      "dct:date": "2026-11-20"
    },
    {
      "@id": "ndl:exchange/public-procurement",
      "@type": "schema:Action",
      "schema:name": "Bid for a public contract: one platform, one data standard",
      "schema:description": "Procurement notices and supplier information, with unique identifiers for authorities, suppliers, procurements and contracts",
      "ndl:journey": "Find and bid for a public contract",
      "schema:audience": "Business",
      "schema:participant": [
        "Cabinet Office (central digital platform)",
        "Contracting authorities",
        "Suppliers"
      ],
      "ndl:mechanism": "All notices under the Procurement Act 2023 are published on the central digital platform, structured in OCDS",
      "ndl:sharedIdentifier": [
        "Supplier and contracting authority identifiers"
      ],
      "dct:references": [
        {
          "@id": "ndl:standard/ocds"
        },
        {
          "@id": "ndl:standard/cyber-essentials"
        }
      ],
      "dct:source": [
        "https://www.gov.uk/government/publications/procurement-act-2023-guidance-documents-procure-phase/guidance-central-digital-platform-and-publication-of-information-html",
        "https://www.gov.uk/government/publications/procurement-act-2023-short-guides/buyers-and-suppliers-how-to-use-the-central-digital-platform-the-enhanced-find-a-tender-service-html"
      ],
      "ndl:provenance": "S",
      "dct:date": "2026-11-20"
    },
    {
      "@id": "ndl:exchange/education-fraud",
      "@type": "schema:Action",
      "schema:name": "Education funding fraud checks by API",
      "schema:description": "Data to prevent fraud in education funding",
      "ndl:journey": "Apply for education funding",
      "schema:audience": "Public body",
      "schema:participant": [
        "DfE",
        "HMRC"
      ],
      "ndl:mechanism": "API",
      "ndl:sharedIdentifier": [
        "National Insurance number"
      ],
      "dct:references": [
        {
          "@id": "ndl:standard/api-standards"
        }
      ],
      "dct:source": [
        "https://www.digital-economy-act-register.data.gov.uk/agreements/279"
      ],
      "ndl:provenance": "V",
      "dct:date": "2026-11-20"
    },
    {
      "@id": "ndl:xgov-mem-classes",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "xGov MEM classes",
      "dct:source": "https://github.com/co-cddo/ukgov-metadata-exchange-model"
    },
    {
      "@id": "ndl:class/ContactPoint",
      "@type": "skos:Concept",
      "skos:prefLabel": "ContactPoint",
      "skos:exactMatch": "vcard:Kind",
      "skos:inScheme": {
        "@id": "ndl:xgov-mem-classes"
      },
      "skos:note": "Required attributes: contactName, email"
    },
    {
      "@id": "ndl:class/DataService",
      "@type": "skos:Concept",
      "skos:prefLabel": "DataService",
      "skos:exactMatch": "dcat:DataService",
      "skos:inScheme": {
        "@id": "ndl:xgov-mem-classes"
      },
      "skos:note": "Required attributes: accessRights, contactPoint, creator, description, identifier, licence, modified, publisher, securityClassification, title, type, version, endpointDescription, serviceStatus, serviceType"
    },
    {
      "@id": "ndl:class/Dataset",
      "@type": "skos:Concept",
      "skos:prefLabel": "Dataset",
      "skos:exactMatch": "dcat:Dataset",
      "skos:inScheme": {
        "@id": "ndl:xgov-mem-classes"
      },
      "skos:note": "Required attributes: accessRights, contactPoint, creator, description, identifier, licence, modified, publisher, securityClassification, title, type, version, updateFrequency"
    },
    {
      "@id": "ndl:class/Distribution",
      "@type": "skos:Concept",
      "skos:prefLabel": "Distribution",
      "skos:exactMatch": "dcat:Distribution",
      "skos:inScheme": {
        "@id": "ndl:xgov-mem-classes"
      },
      "skos:note": "Required attributes: identifier, licence, mediaType, title, type"
    },
    {
      "@id": "ndl:class/Organisation",
      "@type": "skos:Concept",
      "skos:prefLabel": "Organisation",
      "skos:exactMatch": "foaf:Organization",
      "skos:inScheme": {
        "@id": "ndl:xgov-mem-classes"
      },
      "skos:note": "Required attributes: identifier, title"
    },
    {
      "@id": "ndl:glossary",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Glossary"
    },
    {
      "@id": "ndl:term/ai-assistant",
      "@type": "skos:Concept",
      "skos:prefLabel": "AI assistant",
      "skos:definition": "A chat tool such as Claude, ChatGPT or Copilot that answers questions in everyday language. With an MCP server plugged in, it can look things up in sources it could not reach on its own.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/api",
      "@type": "skos:Concept",
      "skos:prefLabel": "API",
      "skos:definition": "Application programming interface: a way for one computer system to ask another for data or to do something, without a person in between. Many government services offer APIs alongside their websites.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/api-catalogue",
      "@type": "skos:Concept",
      "skos:prefLabel": "API catalogue",
      "skos:definition": "A list of APIs with what each does, who provides it and where its documentation is. The UK public sector API catalogue is at api.gov.uk; api_search reads it at a pinned commit.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/ckan",
      "@type": "skos:Concept",
      "skos:prefLabel": "CKAN",
      "skos:definition": "The open-source catalogue software behind data.gov.uk. Its \"action API\" is what this server calls.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/class",
      "@type": "skos:Concept",
      "skos:prefLabel": "Class",
      "skos:definition": "A kind of thing in xGov MEM, for example Dataset or DataService.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/co-design",
      "@type": "skos:Concept",
      "skos:prefLabel": "Co-design",
      "skos:definition": "Designing a service with the people who will use it, not only for them: they shape the personas, journeys and changes.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/crosswalk",
      "@type": "skos:Concept",
      "skos:prefLabel": "Crosswalk",
      "skos:definition": "A mapping from one metadata format to another; here, from a data.gov.uk entry to xGov MEM.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/curie",
      "@type": "skos:Concept",
      "skos:prefLabel": "CURIE",
      "skos:definition": "A short form of a web address, written prefix:name. For example, dcat:Dataset.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/dam-policy",
      "@type": "skos:Concept",
      "skos:prefLabel": "DAM policy",
      "skos:definition": "The cross-government policy on critical data assets (the successor to the Essential Shared Data Asset policy), with returns to GDS from January 2027.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/data-champion",
      "@type": "skos:Concept",
      "skos:prefLabel": "Data champion",
      "skos:definition": "Someone who promotes good data practice in their own organisation, often alongside their main job.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/data-exchange",
      "@type": "skos:Concept",
      "skos:prefLabel": "Data exchange",
      "skos:definition": "Data passing from one organisation to another for a stated purpose, such as payroll earnings going from HMRC to DWP so Universal Credit can be worked out.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/data-service",
      "@type": "skos:Concept",
      "skos:prefLabel": "Data service",
      "skos:definition": "In DCAT, a set of operations, such as an API, that gives access to datasets or data processing. DCAT-AP-UK describes APIs this way, so they can be catalogued like datasets.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/data-gov-uk",
      "@type": "skos:Concept",
      "skos:prefLabel": "data.gov.uk",
      "skos:definition": "The UK's national catalogue of public sector data.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/dcat",
      "@type": "skos:Concept",
      "skos:prefLabel": "DCAT",
      "skos:definition": "Data Catalog Vocabulary, the W3C standard for describing datasets in catalogues. xGov MEM builds on it.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/distribution",
      "@type": "skos:Concept",
      "skos:prefLabel": "Distribution",
      "skos:definition": "One available form of a dataset, such as a CSV file or an API.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/finding",
      "@type": "skos:Concept",
      "skos:prefLabel": "Finding",
      "skos:definition": "One problem the validator reports, with a severity, a path and a message.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/information-sharing-agreement",
      "@type": "skos:Concept",
      "skos:prefLabel": "Information sharing agreement",
      "skos:definition": "A written agreement between organisations setting out what personal data they share, why, how, for how long and under which law. Agreements under the Digital Economy Act 2017 are listed on a public register.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/legal-gateway",
      "@type": "skos:Concept",
      "skos:prefLabel": "Legal gateway",
      "skos:definition": "The law that allows one public body to share data with another for a particular purpose. Without one, a body may not be allowed to share, even when sharing would help.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/linkml",
      "@type": "skos:Concept",
      "skos:prefLabel": "LinkML",
      "skos:definition": "The modelling language xGov MEM is written in.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/mcp",
      "@type": "skos:Concept",
      "skos:prefLabel": "MCP",
      "skos:definition": "Model Context Protocol: an open standard for connecting AI assistants to tools and data.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/mcp-prompt",
      "@type": "skos:Concept",
      "skos:prefLabel": "MCP prompt",
      "skos:definition": "A ready-made task an MCP server offers to an AI assistant, such as 'map the data exchanges behind a journey'. It is text that asks the assistant to use the tools; it does not act by itself.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/mcp-server",
      "@type": "skos:Concept",
      "skos:prefLabel": "MCP server",
      "skos:definition": "A program that offers tools and resources to an AI assistant using MCP. This repository is one.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/metadata",
      "@type": "skos:Concept",
      "skos:prefLabel": "Metadata",
      "skos:definition": "Data about data: the title, description, publisher, licence, dates and format that tell you what a dataset is and whether you can use it.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/national-data-library",
      "@type": "skos:Concept",
      "skos:prefLabel": "National Data Library",
      "skos:definition": "The UK government's programme, led by DSIT with GDS, to make public sector data easier to find and use. Since early 2026 the data.gov.uk website has been turning into it. The NDL in this project's name.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/open-standard",
      "@type": "skos:Concept",
      "skos:prefLabel": "Open standard",
      "skos:definition": "A published, openly available specification that anyone can use, so that different systems and organisations can work together without being tied to one supplier.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/persona",
      "@type": "skos:Concept",
      "skos:prefLabel": "Persona",
      "skos:definition": "A short description of a type of user: their context, goals and pain points. A proto-persona is written from assumptions and has not yet been tested with real users.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/provenance-label",
      "@type": "skos:Concept",
      "skos:prefLabel": "Provenance label",
      "skos:definition": "How sure a stated fact is: V verified at the primary source, S found through search, K background knowledge, U unconfirmed.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/read-only",
      "@type": "skos:Concept",
      "skos:prefLabel": "Read-only",
      "skos:definition": "Only looks at information; never changes, adds or deletes anything. Every tool in this server is read-only.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/recommended-attribute",
      "@type": "skos:Concept",
      "skos:prefLabel": "Recommended attribute",
      "skos:definition": "An attribute xGov MEM advises but does not require. Missing ones give warnings, not errors.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/required-attribute",
      "@type": "skos:Concept",
      "skos:prefLabel": "Required attribute",
      "skos:definition": "An attribute a record must have to meet xGov MEM.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/service-blueprint",
      "@type": "skos:Concept",
      "skos:prefLabel": "Service blueprint",
      "skos:definition": "A diagram of a journey in lanes: what the person does and sees (front stage), what happens behind it (back stage) and what supports it.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/shared-identifier",
      "@type": "skos:Concept",
      "skos:prefLabel": "Shared identifier",
      "skos:definition": "A key two organisations both use for the same thing, such as a company number, VAT number, EORI number, commodity code or address reference, so their data can be joined.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/slot",
      "@type": "skos:Concept",
      "skos:prefLabel": "Slot",
      "skos:definition": "LinkML's word for an attribute.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/tool",
      "@type": "skos:Concept",
      "skos:prefLabel": "Tool",
      "skos:definition": "A single action an MCP server offers, such as metadata_validate.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/user-journey",
      "@type": "skos:Concept",
      "skos:prefLabel": "User journey",
      "skos:definition": "The stages a person goes through to reach a goal with a service, from first need to done.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/vaccination",
      "@type": "skos:Concept",
      "skos:prefLabel": "Vaccination",
      "skos:definition": "Proving a check works by breaking the thing it guards and showing that the check fails.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:term/xgov-mem",
      "@type": "skos:Concept",
      "skos:prefLabel": "xGov MEM",
      "skos:definition": "The UK Cross-Government Metadata Exchange Model: the endorsed model for exchanging metadata about datasets and data services across government.",
      "skos:inScheme": {
        "@id": "ndl:glossary"
      }
    },
    {
      "@id": "ndl:adr/0001-rescope-to-discoverability",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0001: re-scope from citizen advice to data discoverability",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0001-rescope-to-discoverability.md"
    },
    {
      "@id": "ndl:adr/0002-official-and-personal-repositories",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0002: one official repository, one personal experiment",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0002-official-and-personal-repositories.md"
    },
    {
      "@id": "ndl:adr/0003-typescript-mcp-sdk-stdio",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0003: TypeScript, the official MCP SDK and stdio transport",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0003-typescript-mcp-sdk-stdio.md"
    },
    {
      "@id": "ndl:adr/0004-model-is-source-of-truth",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0004: the xGov MEM model is the source of truth, and nothing is guessed",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0004-model-is-source-of-truth.md"
    },
    {
      "@id": "ndl:adr/0005-term-layer-and-federation",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0005: a term layer with reported certification, and an estate register of MCP servers",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0005-term-layer-and-federation.md"
    },
    {
      "@id": "ndl:adr/0006-independent-prototype",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0006: present this repository as an independent prototype",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0006-independent-prototype.md"
    },
    {
      "@id": "ndl:adr/0007-licence-cc-by",
      "@type": "schema:CreativeWork",
      "schema:name": "ADR 0007: license this repository's own content under CC BY 4.0, © Emanuel Silva",
      "schema:url": "https://github.com/cyberdudeuk/ndl-pubsec-mcp/blob/main/docs/adr/0007-licence-cc-by.md"
    },
    {
      "@id": "ndl:persona/publisher",
      "@type": "schema:Audience",
      "schema:audienceType": "Catalogue publisher",
      "schema:description": "Get records complete and correct before a return, an audit or a release, without learning the whole standard first.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/dataset_describe"
        },
        {
          "@id": "ndl:tool/metadata_validate"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/fix-a-record"
      }
    },
    {
      "@id": "ndl:persona/analyst",
      "@type": "schema:Audience",
      "schema:audienceType": "Analyst or researcher",
      "schema:description": "Find candidate datasets, judge whether they are fit for the question, and cite them properly.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/catalogue_search"
        },
        {
          "@id": "ndl:tool/dataset_describe"
        },
        {
          "@id": "ndl:tool/standard_explain"
        },
        {
          "@id": "ndl:tool/api_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/find-data"
      }
    },
    {
      "@id": "ndl:persona/standards-lead",
      "@type": "schema:Audience",
      "schema:audienceType": "Metadata or standards lead",
      "schema:description": "See how far records are from xGov MEM, find the common gaps, and explain the standards in plain terms.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/metadata_validate"
        },
        {
          "@id": "ndl:tool/standard_explain"
        },
        {
          "@id": "ndl:tool/term_lookup"
        },
        {
          "@id": "ndl:tool/api_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/assess-estate"
      }
    },
    {
      "@id": "ndl:persona/builder",
      "@type": "schema:Audience",
      "schema:audienceType": "Developer or AI builder",
      "schema:description": "Add data discovery and metadata checks to an assistant safely, with predictable inputs and no side effects.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/catalogue_search"
        },
        {
          "@id": "ndl:tool/dataset_describe"
        },
        {
          "@id": "ndl:tool/metadata_validate"
        },
        {
          "@id": "ndl:tool/standard_explain"
        },
        {
          "@id": "ndl:tool/term_lookup"
        },
        {
          "@id": "ndl:tool/domain_list"
        },
        {
          "@id": "ndl:tool/api_search"
        },
        {
          "@id": "ndl:tool/server_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/set-up"
      }
    },
    {
      "@id": "ndl:persona/policy",
      "@type": "schema:Audience",
      "schema:audienceType": "Policy or product colleague",
      "schema:description": "Get a plain-English answer they can trust, with a link to the source they can pass on.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/catalogue_search"
        },
        {
          "@id": "ndl:tool/standard_explain"
        },
        {
          "@id": "ndl:tool/term_lookup"
        },
        {
          "@id": "ndl:tool/api_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/find-data"
      }
    },
    {
      "@id": "ndl:persona/champion",
      "@type": "schema:Audience",
      "schema:audienceType": "Data champion",
      "schema:description": "Show colleagues something useful in under an hour and leave them able to carry on alone.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/metadata_validate"
        },
        {
          "@id": "ndl:tool/catalogue_search"
        },
        {
          "@id": "ndl:tool/standard_explain"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/champion"
      }
    },
    {
      "@id": "ndl:persona/contributor",
      "@type": "schema:Audience",
      "schema:audienceType": "Contributor or co-designer",
      "schema:description": "Make a change that is accepted, and see what happened to their idea.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/standard_explain"
        },
        {
          "@id": "ndl:tool/domain_list"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/champion"
      }
    },
    {
      "@id": "ndl:persona/trade-analyst",
      "@type": "schema:Audience",
      "schema:audienceType": "Export finance or trade analyst",
      "schema:description": "Know today which HMRC and other published APIs could help, how access works, and what needs a legal route, without waiting for a new platform.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/api_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        },
        {
          "@id": "ndl:tool/standard_explain"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/find-data"
      }
    },
    {
      "@id": "ndl:persona/researcher",
      "@type": "schema:Audience",
      "schema:audienceType": "Researcher, journalist or civil society organisation",
      "schema:description": "Find the data, the rules and the exchanges behind a public service, with sources good enough to cite.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/catalogue_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        },
        {
          "@id": "ndl:tool/standard_explain"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/find-data"
      }
    },
    {
      "@id": "ndl:persona/ai-developer",
      "@type": "schema:Audience",
      "schema:audienceType": "AI model or MCP developer",
      "schema:description": "Connect assistants to government data through a read-only server with clear safeguards, sources and provenance on every answer.",
      "ndl:status": "proto-persona",
      "ndl:usesTool": [
        {
          "@id": "ndl:tool/catalogue_search"
        },
        {
          "@id": "ndl:tool/api_search"
        },
        {
          "@id": "ndl:tool/server_search"
        },
        {
          "@id": "ndl:tool/exchange_search"
        }
      ],
      "ndl:journey": {
        "@id": "ndl:journey/set-up"
      }
    },
    {
      "@id": "ndl:journey/set-up",
      "@type": "schema:HowTo",
      "schema:name": "Set up and try",
      "schema:audience": [
        {
          "@id": "ndl:persona/builder"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:name": "Discover",
          "schema:text": "Lands on this page from a link or a search"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:name": "Try without installing",
          "schema:text": "Pastes a record into the checker"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:name": "Install",
          "schema:text": "Clones, installs and builds"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:name": "Connect",
          "schema:text": "Adds the server to an assistant's settings"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:name": "First call",
          "schema:text": "Asks a question that needs a tool"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:name": "Keep using",
          "schema:text": "Updates to new releases"
        }
      ]
    },
    {
      "@id": "ndl:journey/find-data",
      "@type": "schema:HowTo",
      "schema:name": "Find and judge data",
      "schema:audience": [
        {
          "@id": "ndl:persona/analyst"
        },
        {
          "@id": "ndl:persona/policy"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:name": "Ask",
          "schema:text": "Describes what they need in their own words"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:name": "Search",
          "schema:text": "Narrows by publisher or topic"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:name": "Shortlist",
          "schema:text": "Picks two or three candidates"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:name": "Describe",
          "schema:text": "Opens one dataset in detail"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:name": "Judge",
          "schema:text": "Decides whether it is fit for the question"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:name": "Use and cite",
          "schema:text": "Uses the data and cites the catalogue entry"
        }
      ]
    },
    {
      "@id": "ndl:journey/fix-a-record",
      "@type": "schema:HowTo",
      "schema:name": "Fix a catalogue record",
      "schema:audience": [
        {
          "@id": "ndl:persona/publisher"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:name": "Pick a record",
          "schema:text": "Chooses a record due for a return or review"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:name": "See the gaps",
          "schema:text": "Asks for the record against xGov MEM"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:name": "Fill the gaps",
          "schema:text": "Finds the missing facts from the people who hold them"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:name": "Check",
          "schema:text": "Validates the corrected record"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:name": "Publish",
          "schema:text": "Updates the record in their own catalogue"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:name": "Re-check",
          "schema:text": "Checks again after the catalogue harvests"
        }
      ]
    },
    {
      "@id": "ndl:journey/assess-estate",
      "@type": "schema:HowTo",
      "schema:name": "Assess a set of records",
      "schema:audience": [
        {
          "@id": "ndl:persona/standards-lead"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:name": "Sample",
          "schema:text": "Chooses a publisher or a theme to look at"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:name": "Check each record",
          "schema:text": "Asks the assistant to describe and check each in turn"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:name": "Find patterns",
          "schema:text": "Looks for the attributes missing most often"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:name": "Explain",
          "schema:text": "Explains the gaps and standards to publishers"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:name": "Report",
          "schema:text": "Writes up findings and actions"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:name": "Re-check",
          "schema:text": "Repeats the sample after fixes"
        }
      ]
    },
    {
      "@id": "ndl:journey/champion",
      "@type": "schema:HowTo",
      "schema:name": "Champion and contribute",
      "schema:audience": [
        {
          "@id": "ndl:persona/champion"
        },
        {
          "@id": "ndl:persona/contributor"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:name": "Try",
          "schema:text": "Uses the checker and a few prompts"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:name": "Show others",
          "schema:text": "Runs a short session for colleagues"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:name": "Gather feedback",
          "schema:text": "Collects what worked and what did not"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:name": "Raise it",
          "schema:text": "Sends feedback, a bug or an idea"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:name": "Co-design",
          "schema:text": "Joins a session to shape a change"
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:name": "Contribute",
          "schema:text": "Opens a pull request"
        }
      ]
    },
    {
      "@id": "ndl:tutorial/tut-first-check",
      "@type": "schema:HowTo",
      "schema:name": "Check your first record in two minutes, with nothing to install",
      "schema:audience": [
        {
          "@id": "ndl:persona/publisher"
        },
        {
          "@id": "ndl:persona/policy"
        },
        {
          "@id": "ndl:persona/champion"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:text": "Go to Check a record on this page."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:text": "Choose the example called 'Two required attributes missing'. The record appears in the box."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:text": "Leave Class as 'Work it out from the record' and select Check the record."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:text": "Read the findings. Each one names the attribute and whether it is an error (must fix) or a warning (recommended)."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:text": "Now paste one of your own records, as JSON. Nothing you paste leaves your browser."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:text": "Fix the errors in your source system, not here: this checker only reads."
        }
      ]
    },
    {
      "@id": "ndl:tutorial/tut-install",
      "@type": "schema:HowTo",
      "schema:name": "Install the server and connect your assistant",
      "schema:audience": [
        {
          "@id": "ndl:persona/builder"
        },
        {
          "@id": "ndl:persona/analyst"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:text": "Check you have Node.js 20 or later: run node --version."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:text": "Clone, install and build with the four commands in Quick start."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:text": "Add the server to your assistant using the snippet for Claude Desktop or VS Code. Replace the path with where you cloned it."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:text": "Restart the assistant. It should list the tools in the data dictionary."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:text": "Not working? Run npm run inspector and call a tool by hand. If it works there, the problem is the assistant's settings."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:text": "Ask: 'Which standards can you explain?' The answer should come from standard_explain."
        }
      ]
    },
    {
      "@id": "ndl:tutorial/tut-fix-record",
      "@type": "schema:HowTo",
      "schema:name": "Fix a catalogue record from start to finish",
      "schema:audience": [
        {
          "@id": "ndl:persona/publisher"
        },
        {
          "@id": "ndl:persona/standards-lead"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:text": "Pick one record you are responsible for. Note its data.gov.uk name or id."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:text": "Ask your assistant to describe it and list what its xGov MEM record lacks (worked example: See how ready a catalogue entry is)."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:text": "Download the Dataset record template and the readiness checklist from the toolkit."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:text": "Fill the gaps from the people who hold the facts. Do not invent values: an empty gap is better than a wrong one."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:text": "Validate the finished record with metadata_validate or the in-page checker until there are no errors."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:text": "Update the record in your own catalogue. This server never writes anywhere."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 7,
          "schema:text": "After the catalogue next harvests, describe the record again to confirm the gaps have closed."
        }
      ]
    },
    {
      "@id": "ndl:tutorial/tut-add-standard",
      "@type": "schema:HowTo",
      "schema:name": "Make a first contribution: add or correct a standard",
      "schema:audience": [
        {
          "@id": "ndl:persona/contributor"
        },
        {
          "@id": "ndl:persona/builder"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:text": "Read the contributing guide and fork the repository."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:text": "Open src/data/standards.json. Each entry has a name, purpose, status, licence, link, provenance label and check date."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:text": "Read the standard at its primary source. Set the provenance to V only if you checked it there, with today's date; otherwise use S, K or U."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:text": "Run npm run verify. It rebuilds the page and runs every check."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:text": "Open a pull request explaining what you checked and where."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:text": "The maintainer reviews it. If it is merged, the page updates on the next build."
        }
      ]
    },
    {
      "@id": "ndl:tutorial/tut-show-and-tell",
      "@type": "schema:HowTo",
      "schema:name": "Run a 45-minute show-and-tell",
      "schema:audience": [
        {
          "@id": "ndl:persona/champion"
        },
        {
          "@id": "ndl:persona/standards-lead"
        }
      ],
      "schema:step": [
        {
          "@type": "schema:HowToStep",
          "schema:position": 1,
          "schema:text": "Download the session plan and the champion pack from the toolkit."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 2,
          "schema:text": "Before the session, run each worked example you plan to show, so you know what to expect."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 3,
          "schema:text": "Open with the problem, not the tool: ask who has had a record rejected or could not find data."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 4,
          "schema:text": "Show the in-page checker live. It needs no install and no network."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 5,
          "schema:text": "Let people try one of their own records, in pairs."
        },
        {
          "@type": "schema:HowToStep",
          "schema:position": 6,
          "schema:text": "Close with the feedback questions, then raise what you heard through the contact form."
        }
      ]
    },
    {
      "@id": "ndl:example/ex-missing",
      "@type": "schema:CreativeWork",
      "schema:name": "Check a record before it goes out",
      "schema:text": "Check this Dataset record against xGov MEM and list anything I must fix before I publish it: <paste the record>",
      "schema:audience": [
        {
          "@id": "ndl:persona/publisher"
        },
        {
          "@id": "ndl:persona/champion"
        }
      ],
      "dct:references": {
        "@id": "ndl:tool/metadata_validate"
      }
    },
    {
      "@id": "ndl:example/ex-journey",
      "@type": "schema:CreativeWork",
      "schema:name": "What data moves when someone dies?",
      "schema:text": "Using exchange_search, show the data exchanges behind registering and reporting a death: who is told, what moves, which identifiers join it, the legal basis and sources. Then list what still relies on email or paper.",
      "schema:audience": [
        {
          "@id": "ndl:persona/analyst"
        },
        {
          "@id": "ndl:persona/policy"
        }
      ],
      "dct:references": {
        "@id": "ndl:tool/exchange_search"
      }
    },
    {
      "@id": "ndl:example/ex-misspelt",
      "@type": "schema:CreativeWork",
      "schema:name": "Catch a misspelt attribute",
      "schema:text": "Validate this record and tell me if any attribute names are not in the model: <paste the record>",
      "schema:audience": [
        {
          "@id": "ndl:persona/publisher"
        },
        {
          "@id": "ndl:persona/standards-lead"
        }
      ],
      "dct:references": {
        "@id": "ndl:tool/metadata_validate"
      }
    },
    {
      "@id": "ndl:example/ex-bad-enum",
      "@type": "schema:CreativeWork",
      "schema:name": "Spot a value outside the allowed list",
      "schema:text": "Check this record and, for any value outside the model's list, show me the allowed values: <paste the record>",
      "schema:audience": [
        {
          "@id": "ndl:persona/publisher"
        },
        {
          "@id": "ndl:persona/standards-lead"
        }
      ],
      "dct:references": {
        "@id": "ndl:tool/metadata_validate"
      }
    },
    {
      "@id": "ndl:example/ex-ukef-hmrc",
      "@type": "schema:CreativeWork",
      "schema:name": "What could connect UK Export Finance and HMRC?",
      "schema:text": "Find HMRC APIs that could help an export finance team check an exporter's VAT and EORI numbers and size a market for a product. For each, give the documentation link, how access works, and whether it is in the government API catalogue.",
      "schema:audience": [
        {
          "@id": "ndl:persona/analyst"
        },
        {
          "@id": "ndl:persona/builder"
        },
        {
          "@id": "ndl:persona/standards-lead"
        }
      ],
      "dct:references": {
        "@id": "ndl:tool/api_search"
      }
    },
    {
      "@id": "ndl:example/ex-find",
      "@type": "schema:CreativeWork",
      "schema:name": "Find data on a topic",
