        }
      ]
    },
    {
      "@id": "ndl:tool/catalogue_search",
      "@type": "schema:EntryPoint",
      "schema:name": "catalogue_search",
      "schema:description": "Search the data.gov.uk catalogue of UK public sector datasets. Returns titles, publishers, licences, formats, last-modified dates and links. Read-only; no personal data is returned.",
      "dct:references": []
    },
    {
      "@id": "ndl:tool/dataset_describe",
      "@type": "schema:EntryPoint",
      "schema:name": "dataset_describe",
      "schema:description": "Get one data.gov.uk dataset: its description, publisher, licence and distributions, plus a draft UK Cross-Government Metadata Exchange Model (xGov MEM) record and what that record still lacks. Nothing is guessed: fields the catalogue does not hold are reported as missing.",
      "dct:references": [
        {
          "@id": "ndl:standard/xgov-mem"
        }
      ]
    },
    {
      "@id": "ndl:tool/metadata_validate",
      "@type": "schema:EntryPoint",
      "schema:name": "metadata_validate",
      "schema:description": "Check a metadata record against the UK Cross-Government Metadata Exchange Model (xGov MEM, commit d6d9a24). Classes: ContactPoint, DataService, Dataset, Distribution, Organisation. Returns errors (must fix) and warnings (recommended), each with the attribute path.",
      "dct:references": [
        {
          "@id": "ndl:standard/xgov-mem"
        },
        {
          "@id": "ndl:standard/dcat"
        }
      ]
    },
    {
      "@id": "ndl:tool/standard_explain",
      "@type": "schema:EntryPoint",
      "schema:name": "standard_explain",
      "schema:description": "Explain open data standards used across UK government (xGov MEM, DCAT, ATRS, BODS, CSV, OpenAPI and others): purpose, status, licence and link, each with its provenance label and check date. Leave id out to list them all.",
      "dct:references": []
    },
    {
      "@id": "ndl:tool/term_lookup",
      "@type": "schema:EntryPoint",
      "schema:name": "term_lookup",
      "schema:description": "Find business terms in the configured vocabulary and report, for each, its definition, its status, who drafted it (person or AI), the review level it passed (H0 to H5) and whether that makes it certified. A term counts as certified only when it is endorsed after H2 review or above; anything unrecorded is reported as unknown, never assumed. Leave query and id out for a summary of the vocabulary.",
      "dct:references": []
    },
    {
      "@id": "ndl:tool/domain_list",
      "@type": "schema:EntryPoint",
      "schema:name": "domain_list",
      "schema:description": "List the MCP servers that work alongside this one (for example the Public Sector Data Quality Commons), with what each is for, its tools, its safety statement and where its manifest came from. This server does not call them.",
      "dct:references": []
    },
    {
      "@id": "ndl:tool/api_search",
      "@type": "schema:EntryPoint",
      "schema:name": "api_search",
      "schema:description": "Search UK public sector APIs by words in their name, provider or description, optionally for one provider. Draws on the UK public sector API catalogue at a pinned commit, plus APIs added by name after checking them at the publisher's page (each says which). Returns name, provider, description, endpoint and documentation links, and the source of each entry. Read-only: this server lists APIs and never calls them, holds no keys and passes no data. Listing is not endorsement, and using an API may need its own sign-up or a legal basis.",
      "dct:references": []
    },
    {
      "@id": "ndl:tool/server_search",
      "@type": "schema:EntryPoint",
      "schema:name": "server_search",
      "schema:description": "List or search MCP servers an agent might use alongside this one: the estate's own servers (with their manifests or repositories) and public candidates awaiting the owner's review. Each entry says its status, where it was checked and when. Candidates are not endorsed. This server never calls any of them.",
      "dct:references": []
    },
    {
      "@id": "ndl:standard/xgov-mem",
      "@type": "schema:CreativeWork",
      "schema:name": "UK Cross-Government Metadata Exchange Model (xGov MEM)",
      "schema:url": "https://co-cddo.github.io/ukgov-metadata-exchange-model/",
      "schema:license": "Open Government Licence v3.0",
      "schema:creativeWorkStatus": "Endorsed for implementation by the Data Standards Authority Steering Board",
      "ndl:provenance": "S",
      "dct:date": "2026-11-08"
    },
    {
